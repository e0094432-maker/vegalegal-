# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Входящий вебхук Bitrix24 (без метода на конце), например:
# https://ваш-портал.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx
BITRIX_WEBHOOK_URL=

# Код стадии сделки, которую нужно показывать (например: NEW, PREPARATION, C2:UC_XXXXX)
DEAL_STAGE_ID=

# Опционально: ID воронки (CATEGORY_ID), если стадия принадлежит не основной воронке
DEAL_CATEGORY_ID=

# Опционально: путь к файлу базы заметок.
# На Render — путь на Persistent Disk, например /var/data/notes.db
# (по умолчанию — notes.db рядом с ботом)
DB_PATH=
